---
import '../styles/global.css';
import { negocio } from '../data/negocio';
import pincel from '@fontsource/protest-revolution/files/protest-revolution-latin-400-normal.woff2?url';

interface Props {
  titulo: string;
  descripcion: string;
}
const { titulo, descripcion } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#0d0f10" />
    <link rel="preload" href={pincel} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    {negocio.ejemplo && (
      <p class="aviso">El nombre de la marca, la dirección de retiro, los horarios y las zonas de envío todavía son de ejemplo.</p>
    )}
    <slot />
  </body>
</html>
