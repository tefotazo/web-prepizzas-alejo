---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { negocio, formatoPrecio, precioPedido, precioSuelto, linkWhatsApp } from '../data/negocio';

const [suelto, ...promos] = negocio.promos;
const consulta = linkWhatsApp('Hola! Quería hacer un pedido de pre-pizzas.');
const mayorista = linkWhatsApp('Hola! Quiero consultar precios especiales por cantidad de pre-pizzas (para un evento o negocio).');
const precios = JSON.stringify(negocio.promos);
const anio = new Date().getFullYear();
---
<Base
  titulo={`${negocio.nombre} · Pedí por WhatsApp`}
  descripcion={`Pre-pizzas caseras con salsa, sin conservantes. Paquete de 2 a ${formatoPrecio(suelto.precio)}, promos por cantidad y precios especiales para eventos y negocios. Pedí al ${negocio.telefono}.`}
>
  <header class="cabecera contenedor">
    <nav class="cabecera__nav" aria-label="Secciones">
      <a href="#precios">Precios</a>
      <a href="#mayor">Por mayor</a>
    </nav>
    <a class="cabecera__tel" href={consulta} target="_blank" rel="noopener">
      <Icono nombre="whatsapp" />
      <span class="cartel">{negocio.telefono}</span>
    </a>
  </header>

  <main>
    <!-- Portada: el titular del flyer y el pedido funcionando -->
    <section class="portada contenedor" aria-labelledby="titular">
      <h1 class="titular" id="titular">
        <span class="titular__venta"><img class="rayas" src="/marca/rayas.svg" alt="" width="120" height="70" /><span class="pincel">Venta de</span></span>
        <span class="titular__pre pincel">Pre-pizzas</span>
        <span class="titular__caseras guion">Caseras</span>
      </h1>

      <p class="lema guion">¡Ricas, prácticas y siempre frescas!</p>

      <figure class="portada__foto">
        <img src="/fotos/par.webp" alt="Dos paquetes de pre-pizzas con salsa, en bolsa transparente" width="710" height="278" />
        <p class="sello sello--rayas portada__sello cartel">
          <span class="sello__linea">{suelto.paquetes} paquete</span>
          <span class="sello__sub">({negocio.paquete.prepizzas} pre-pizzas)</span>
          <span class="sello__precio">{formatoPrecio(suelto.precio)}</span>
        </p>
        <figcaption class="portada__nota guion">La mejor calidad, siempre</figcaption>
      </figure>

      <form class="pedido panel" id="pedido" data-precios={precios} data-wa={`https://wa.me/${negocio.whatsapp}`} data-retiro={negocio.direccionRetiro}>
        <h2 class="banda cartel"><Icono nombre="carrito" />Armá tu pedido</h2>

        <div class="pedido__cantidad">
          <label class="pedido__rotulo cartel" for="paquetes">¿Cuántos paquetes?</label>
          <div class="stepper">
            <button type="button" class="stepper__boton" data-accion="menos" aria-label="Un paquete menos" disabled><Icono nombre="menos" /></button>
            <input class="stepper__numero cartel" id="paquetes" name="paquetes" type="number" inputmode="numeric" min="1" max="99" value="1" />
            <button type="button" class="stepper__boton" data-accion="mas" aria-label="Un paquete más"><Icono nombre="mas" /></button>
          </div>
          <p class="pedido__unidades" data-unidades>= {negocio.paquete.prepizzas} pre-pizzas</p>
        </div>

        <ul class="escalera" role="list" aria-label="Precios por cantidad">
          {negocio.promos.map((p) => (
            <li>
              <button type="button" class="escalon" data-paquetes={p.paquetes} aria-pressed={p.paquetes === 1 ? 'true' : 'false'}>
                <span class="escalon__cant cartel">{p.paquetes} {p.paquetes === 1 ? 'paquete' : 'paquetes'}</span>
                <span class="escalon__precio cartel">{formatoPrecio(p.precio)}</span>
              </button>
            </li>
          ))}
        </ul>

        <fieldset class="entrega">
          <legend class="pedido__rotulo cartel">Entrega</legend>
          <div class="entrega__opciones">
            <label class="opcion">
              <input type="radio" name="entrega" value="retiro" checked />
              <span class="cartel">Retiro</span>
            </label>
            <label class="opcion">
              <input type="radio" name="entrega" value="envio" />
              <span class="cartel">Envío</span>
            </label>
          </div>
          <p class="pedido__nota" data-nota-retiro>Pasás a buscar por {negocio.direccionRetiro}, {negocio.barrio}.</p>
          <div class="campo" data-direccion hidden>
            <label for="direccion">¿A qué dirección te las llevamos?</label>
            <input id="direccion" name="direccion" type="text" autocomplete="street-address" placeholder="Calle, número y barrio" />
            <p class="pedido__nota">{negocio.envio}</p>
          </div>
        </fieldset>

        <div class="campo campo--dia">
          <label for="dia">¿Para qué día?</label>
          <input id="dia" name="dia" type="date" />
          <p class="pedido__nota"><Icono nombre="calendario" /> Recordá encargar con anticipación.</p>
        </div>

        <div class="total">
          <div class="total__cifra">
            <span class="total__rotulo cartel">Total</span>
            <span class="total__monto sello cartel" data-total>{formatoPrecio(precioPedido(1))}</span>
            <span class="total__ahorro guion" data-ahorro hidden></span>
          </div>
          <p class="pedido__nota total__estimado" data-estimado hidden>Para más de {promos[promos.length - 1].paquetes} paquetes el total es estimado: te lo confirmamos por WhatsApp.</p>
          <a class="boton total__boton" href={consulta} data-cta-pedido target="_blank" rel="noopener">
            <Icono nombre="whatsapp" />
            Pedir por WhatsApp
          </a>
        </div>
        <p class="sr-only" aria-live="polite" data-anuncio></p>
      </form>
    </section>

    <!-- Precios: venta por menor y promociones, como los dos recuadros del flyer -->
    <section class="precios contenedor" id="precios" aria-label="Precios">
      <article class="panel menor">
        <h2 class="banda cartel"><Icono nombre="carrito" />Venta por menor</h2>
        <p class="menor__detalle">{negocio.paquete.detalle}</p>
        <div class="menor__cuerpo">
          <figure class="menor__foto">
            <img src="/fotos/izq.webp" alt="Un paquete con dos pre-pizzas" width="372" height="278" loading="lazy" />
            <p class="sello sello--rayas menor__sello cartel">
              <span class="sello__linea">{suelto.paquetes} paquete</span>
              <span class="sello__sub">({negocio.paquete.prepizzas} pre-pizzas)</span>
              <span class="sello__precio">{formatoPrecio(suelto.precio)}</span>
            </p>
          </figure>
          <ul class="tildes" role="list">
            {negocio.caracteristicas.map((c) => <li><Icono nombre="check" />{c}</li>)}
          </ul>
        </div>

      </article>

      <article class="panel promos">
        <h2 class="banda banda--b cartel"><Icono nombre="megafono" />Promociones</h2>
        <ul class="promos__lista" role="list">
          {promos.map((p) => (
            <li class="promo">
              <span class="promo__cant cartel">{p.paquetes}</span>
              <span class="promo__que">
                <span class="cartel">Paquetes</span>
                <span class="promo__sub">({p.paquetes * negocio.paquete.prepizzas} pre-pizzas)</span>
              </span>
              <span class="sello promo__precio cartel">{formatoPrecio(p.precio)}</span>
              <button type="button" class="promo__elegir" data-elegir={p.paquetes}>
                Llevar esta promo
                <span class="promo__ahorro">ahorrás {formatoPrecio(precioSuelto(p.paquetes) - p.precio)}</span>
              </button>
            </li>
          ))}
        </ul>
        <p class="promos__lema guion"><img class="rayas rayas--izq" src="/marca/rayas.svg" alt="" width="120" height="70" />¡Más cantidad, mejor precio!<img class="rayas" src="/marca/rayas.svg" alt="" width="120" height="70" /></p>
      </article>
    </section>

    <!-- Venta al por mayor -->
    <section class="contenedor" id="mayor" aria-labelledby="mayor-titulo">
      <article class="panel mayor">
        <h2 class="banda banda--b cartel" id="mayor-titulo"><Icono nombre="manos" />Venta al por mayor</h2>
        <div class="mayor__grilla">
          <div>
            <p class="mayor__ideal">Ideal para <span class="guion">eventos</span> y <span class="guion">negocios</span></p>
            <ul class="tildes mayor__rubros" role="list">
              {negocio.mayorista.rubros.map((r) => (
                <li><Icono nombre={r.icono} class="mayor__rubro" /><Icono nombre="check" />{r.texto}</li>
              ))}
            </ul>
          </div>
          <div class="mayor__foto">
            <div class="pila" role="img" aria-label="Paquetes de pre-pizzas apilados para pedidos grandes">
              <img class="pila__bolsa pila__bolsa--1" src="/fotos/izq.webp" alt="" width="372" height="278" loading="lazy" />
              <img class="pila__bolsa pila__bolsa--2" src="/fotos/der.webp" alt="" width="380" height="278" loading="lazy" />
            </div>
            <a class="sello mayor__sello cartel" href={mayorista} target="_blank" rel="noopener">
              <Icono nombre="caja" class="mayor__caja" />
              <span>
                <span class="sello__linea">Consultá por precios especiales</span>
                <span class="sello__sub">por cantidad <Icono nombre="whatsapp" class="mayor__wa" /></span>
              </span>
            </a>
          </div>
        </div>
      </article>
    </section>

    <!-- Cierre: el número grande, como el pie del flyer -->
    <section class="cierre contenedor" aria-labelledby="cierre-titulo">
      <h2 class="sr-only" id="cierre-titulo">Hacé tu pedido</h2>
      <a class="cierre__llamada" href={consulta} target="_blank" rel="noopener">
        <span class="cierre__wa"><Icono nombre="whatsapp" /></span>
        <span class="cierre__linea cartel">
          <span class="cierre__texto">Hacé tu pedido al</span>
          <span class="cierre__flecha" aria-hidden="true"></span>
          <span class="cierre__numero">{negocio.telefono}</span>
        </span>
      </a>
      <p class="banda cartel cierre__aviso"><Icono nombre="calendario" />Recordá encargar con anticipación, por favor</p>
      <p class="cierre__espera guion">¡Te esperamos!</p>
    </section>
  </main>

  <footer class="pie">
    <div class="contenedor pie__grilla">
      <p class="pie__marca cartel">{negocio.nombre}</p>
      <ul class="pie__datos" role="list">
        <li><Icono nombre="ubicacion" />Retiro: {negocio.direccionRetiro}, {negocio.barrio}</li>
        <li><Icono nombre="envio" />Envío: {negocio.zonasEnvio.join(' · ')}</li>
        <li><Icono nombre="reloj" />{negocio.horario}</li>
      </ul>
      <p class="pie__legal">© {anio} {negocio.nombre}</p>
    </div>
  </footer>

  <!-- Barra fija con el pedido, cuando el total queda fuera de pantalla -->
  <div class="barra" data-barra hidden>
    <span class="barra__resumen cartel" data-barra-resumen></span>
    <a class="boton barra__cta" href={consulta} data-cta-pedido target="_blank" rel="noopener">
      <Icono nombre="whatsapp" />
      Pedir
    </a>
  </div>
</Base>

<script>
  import { iniciarPedido } from '../scripts/pedido';
  iniciarPedido();
</script>

<style>
  /* ---------- Cabecera ---------- */
  .cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
  }

  .cabecera__nav { display: flex; gap: 0.25rem 1.5rem; }

  .cabecera__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--tiza-2);
    text-decoration: none;
  }

  .cabecera__nav a:hover { color: var(--tiza); text-decoration: underline; text-decoration-color: var(--rojo); }

  .cabecera__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 1.35rem;
    text-decoration: none;
  }

  .cabecera__tel :global(.icono) { width: 1.3rem; height: 1.3rem; color: var(--rojo-claro); }

  /* ---------- Portada ---------- */
  .portada {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'titular' 'lema' 'foto' 'pedido';
    padding-top: clamp(0.5rem, 2vh, 1.5rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .titular {
    grid-area: titular;
    display: grid;
    justify-items: start;
    margin: 0;
    font-weight: 400;
    rotate: -3deg;
    transform-origin: left center;
  }

  .titular__venta {
    position: relative;
    margin-left: 0.9em;
    font-size: clamp(2rem, 7.6vw, 4.2rem);
  }

  .rayas {
    position: absolute;
    right: 100%;
    top: 0.05em;
    width: 0.95em;
    height: auto;
    margin-right: 0.12em;
    rotate: 8deg;
  }

  /* La letra del flyer va inclinada hacia adelante */
  .titular__venta .pincel,
  .titular__pre { display: inline-block; transform: skewX(-9deg); }

  .titular__pre {
    font-size: clamp(3.3rem, 15.4vw, 8.6rem);
    padding-bottom: 0.1em;
    background: url('/marca/trazo.svg') left bottom / 100% 0.2em no-repeat;
  }

  .titular__caseras {
    margin: -0.18em 0 0 0.9em;
    color: var(--rojo);
    font-size: clamp(3.2rem, 14vw, 7.6rem);
    padding-bottom: 0.08em;
    background: url('/marca/trazo.svg') 0.2em bottom / 92% 0.14em no-repeat;
    text-shadow: 0 4px 12px rgb(0 0 0 / 0.5);
  }

  .lema {
    grid-area: lema;
    justify-self: end;
    max-width: 11em;
    margin: 0.35em 0 0.2em;
    font-size: clamp(1.35rem, 4.6vw, 2rem);
    text-align: center;
    rotate: -9deg;
  }

  .portada__foto {
    grid-area: foto;
    position: relative;
    margin: clamp(0.5rem, 2vw, 1rem) calc(var(--gutter) * -0.5) 0;
  }

  .portada__foto img { width: 100%; height: auto; }

  .portada__sello {
    position: absolute;
    left: 6%;
    bottom: -1.5rem;
    margin: 0;
    font-size: clamp(0.8rem, 2.6vw, 1.05rem);
  }

  .portada__nota {
    position: absolute;
    right: calc(var(--gutter) * 0.5);
    bottom: -0.6em;
    max-width: 90%;
    font-size: clamp(1.05rem, 3.6vw, 1.6rem);
    rotate: -10deg;
    padding-bottom: 0.1em;
    background: url('/marca/trazo.svg') center bottom / 100% 0.2em no-repeat;
  }

  @media (max-width: 999px) {
    .portada__foto { text-align: right; }
    .portada__nota { position: static; display: inline-block; max-width: none; margin: 0.1rem calc(var(--gutter) * 0.5) 0 0; }
    .portada__sello { left: 9%; bottom: 2.6rem; }
  }

  /* ---------- Pedido ---------- */
  .pedido {
    grid-area: pedido;
    display: grid;
    gap: 1.1rem;
    margin-top: clamp(1.75rem, 5vw, 2.5rem);
    padding-top: 0;
  }

  .pedido > .banda { margin: -1.15em 0 0 -1.25rem; justify-self: start; }

  .pedido__rotulo {
    font-size: 1.3rem;
    color: var(--tiza-2);
    padding: 0;
  }

  .pedido__cantidad {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.25rem 1rem;
  }

  .pedido__unidades { grid-column: 2; margin: 0; text-align: center; color: var(--tiza-2); font-size: 0.95rem; }

  .stepper { display: flex; align-items: center; gap: 0.25rem; }

  .stepper__boton {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    border: 2px solid var(--rojo);
    border-radius: 50%;
    background: none;
    color: var(--tiza);
    cursor: pointer;
    transition: background-color 160ms var(--ease), transform 160ms var(--ease);
  }

  .stepper__boton :global(.icono) { width: 1.5rem; height: 1.5rem; stroke-width: 3; }
  .stepper__boton:hover:not(:disabled) { background: var(--rojo); }
  .stepper__boton:active:not(:disabled) { transform: scale(0.92); }
  .stepper__boton:disabled { border-color: var(--linea); color: var(--tiza-3); cursor: default; }

  .stepper__numero {
    width: 2.2ch;
    padding: 0;
    border: 0;
    background: none;
    color: var(--tiza);
    font-size: 3.4rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    caret-color: var(--rojo);
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .stepper__numero::-webkit-inner-spin-button,
  .stepper__numero::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

  .escalera {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .escalon {
    display: grid;
    width: 100%;
    gap: 0.2rem;
    padding: 0.6rem 0.4rem 0.55rem;
    border: 2px solid var(--linea);
    border-radius: 10px;
    background: var(--carbon-2);
    color: var(--tiza-2);
    cursor: pointer;
    transition: border-color 160ms var(--ease), background-color 200ms var(--ease), color 160ms var(--ease);
  }

  .escalon__cant { font-size: 1.2rem; font-weight: 800; }
  .escalon__precio { font-size: 1.6rem; color: var(--tiza); }

  .escalon:hover { border-color: var(--rojo); color: var(--tiza); }

  .escalon[aria-pressed='true'] {
    border-color: var(--rojo);
    background: var(--rojo);
    color: var(--tiza);
  }

  .entrega { display: grid; gap: 0.6rem; margin: 0; padding: 0; border: 0; }
  .entrega legend { margin-bottom: 0.6rem; }

  .entrega__opciones { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }

  .opcion {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 3rem;
    border: 2px solid var(--linea);
    border-radius: 10px;
    color: var(--tiza-2);
    font-size: 1.4rem;
    cursor: pointer;
    transition: border-color 160ms var(--ease), color 160ms var(--ease);
  }

  .opcion input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .opcion:hover { color: var(--tiza); border-color: var(--tiza-3); }
  .opcion:has(input:checked) { border-color: var(--rojo); color: var(--tiza); box-shadow: inset 0 0 0 1px var(--rojo); }
  .opcion:has(input:focus-visible) { outline: 3px solid var(--tiza); outline-offset: 3px; }

  .pedido__nota { display: flex; align-items: center; gap: 0.45rem; margin: 0; color: var(--tiza-2); font-size: 0.95rem; line-height: 1.35; }
  .pedido__nota[hidden] { display: none; }
  .pedido__nota :global(.icono) { width: 1.05rem; height: 1.05rem; color: var(--rojo-claro); flex: none; }

  .campo { display: grid; gap: 0.45rem; }
  .campo[hidden] { display: none; }
  .campo label { font-weight: 600; }

  .campo input {
    width: 100%;
    min-height: 3.1rem;
    padding: 0.65rem 0.9rem;
    border: 2px solid var(--linea);
    border-radius: 10px;
    background: var(--carbon);
    color: var(--tiza);
    font: inherit;
    caret-color: var(--rojo);
    color-scheme: dark;
  }

  .campo input::placeholder { color: var(--tiza-3); }
  .campo input:focus-visible { outline-offset: 2px; border-color: var(--rojo); }

  @media (min-width: 560px) {
    .campo--dia { grid-template-columns: auto 1fr; align-items: center; column-gap: 1rem; }
    .campo--dia .pedido__nota { grid-column: 1 / -1; }
  }

  .total {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-top: 1rem;
    border-top: 2px dashed var(--linea);
  }

  .total__cifra { display: grid; grid-template-columns: auto auto; align-items: baseline; column-gap: 0.75rem; }
  .total__rotulo { font-size: 1.3rem; color: var(--tiza-2); }
  .total__monto { font-size: clamp(2.3rem, 7vw, 3rem); font-variant-numeric: tabular-nums; padding: 0.3em 0.55em 0.25em; rotate: -3deg; }
  .total__estimado { flex-basis: 100%; }
  .total__ahorro { grid-column: 1 / -1; margin-top: 0.3rem; color: var(--rojo-claro); font-size: 1.3rem; rotate: -3deg; transform-origin: left; }
  .total__ahorro[hidden] { display: none; }

  @media (max-width: 559px) {
    .total__boton { width: 100%; }
  }

  /* ---------- Portada en pantallas anchas ---------- */
  @media (min-width: 1000px) {
    .portada {
      grid-template-columns: minmax(0, 1.2fr) minmax(24rem, 0.8fr);
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'titular lema'
        'titular pedido'
        'foto pedido';
      column-gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }

    .titular__venta { font-size: clamp(2.6rem, 3.8vw, 3.8rem); }
    .titular__pre { font-size: clamp(5rem, 8.2vw, 8.2rem); }
    .titular__caseras { font-size: clamp(4.4rem, 6.8vw, 6.8rem); }

    .lema { justify-self: center; margin: 0.4rem 0 0; font-size: clamp(1.4rem, 1.9vw, 1.8rem); }

    .portada__foto { width: 112%; margin: -1rem 0 0 -4%; align-self: center; }

    .pedido { margin-top: 3.4rem; }
  }

  /* ---------- Precios ---------- */
  .precios {
    display: grid;
    gap: 2.75rem 2rem;
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  @media (min-width: 900px) {
    .precios { grid-template-columns: 1fr 1fr; align-items: stretch; }
  }

  .precios .banda,
