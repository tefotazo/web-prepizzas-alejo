---
// Una prepizza dibujada: borde de masa, salsa y los pinchazos del tenedor.
interface Props { giro?: number }
const { giro = 0 } = Astro.props;
---
<svg class="prepizza" viewBox="0 0 64 64" aria-hidden="true" focusable="false" style={`--giro:${giro}deg`}>
  <path class="prepizza__masa" d="M32 3.5c8.6.2 15.6 3.4 20.6 9 5 5.5 7.9 12.4 7.8 19.8-.1 8.1-3.5 15-9.2 20.1-5.3 4.7-11.9 7.6-19.4 7.4-8-.2-15-3.6-20-9.2C6.8 45.1 3.4 38.6 3.6 31.4 3.8 23.5 7.2 16.4 12.8 11.3 18 6.6 24.6 3.3 32 3.5Z" />
  <path class="prepizza__salsa" d="M32 10.5c6.4.1 11.6 2.6 15.3 6.7 3.6 4.1 5.7 9.2 5.6 14.8-.1 6-2.6 11.2-6.8 14.9-4 3.5-8.8 5.6-14.4 5.5-5.9-.1-11-2.7-14.7-6.8-3.4-3.8-5.6-8.6-5.5-14 .1-5.8 2.7-11.1 6.8-14.8 3.9-3.5 8.6-6.4 13.7-6.3Z" />
  <g class="prepizza__pinchazos">
    <circle cx="24" cy="24" r="1.6" /><circle cx="38" cy="21" r="1.6" /><circle cx="43" cy="35" r="1.6" />
    <circle cx="30" cy="34" r="1.6" /><circle cx="21" cy="40" r="1.6" /><circle cx="35" cy="45" r="1.6" />
  </g>
</svg>
